# --- Database & Biometrics (CRITICAL) ---
# Do not upload the local SQLite database
*.db
*.sqlite3

# Do not upload personal student/teacher photos
# This keeps the folder structure but ignores the images
backend/uploads/*
!backend/uploads/.gitkeep

# --- AI/ML Models ---
# Large model files should usually be ignored or handled via Git LFS
*.weights
*.h5
*.pth
*.clf
*.pkl

